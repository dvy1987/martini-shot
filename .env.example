# Martini Shot environment — NAMES ONLY, never commit real values (C-5.1).
# `POST_COMMAND_*` is the internal codename; the product display name is Martini Shot.
# Copy to .env (gitignored) and fill. Cloud Run reads these from Secret Manager.

# ── Google Cloud (plan F-2) ────────────────────────────────────────────────
GCP_PROJECT_ID=
GCS_BUCKET=
FIRESTORE_DATABASE=(default)
# Dev only: path to a least-privilege service-account JSON. Cloud Run uses ADC.
GOOGLE_APPLICATION_CREDENTIALS=

# ── Grafana Cloud (plan F-1) ───────────────────────────────────────────────
GRAFANA_STACK_URL=                  # e.g. https://yourstack.grafana.net
GRAFANA_OTLP_ENDPOINT=              # OTLP endpoint for traces/metrics/logs (C-4.1)
GRAFANA_OTLP_TOKEN=                 # OTLP auth token
MCP_MODE=hosted                     # hosted | oss  (see docs/adr/0001-mcp-auth.md)
GRAFANA_SA_TOKEN=                   # only when MCP_MODE=oss (headless fallback)

# ── Backend API (C-5.2) ────────────────────────────────────────────────────
POST_COMMAND_API_KEY=               # minted at deploy; shared with the FE build
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://YOUR-REPL.replit.app
